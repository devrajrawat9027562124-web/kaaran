# Copy to backend/.env and fill in. backend/.env is ignored by git: never commit keys.

# docker (default, safe) or local (runs gcc/gdb on this machine: your own code only)
KAARAN_SANDBOX=docker
KAARAN_RUNNER_IMAGE=kaaran-runner

# Which websites may call this backend
ALLOWED_ORIGINS=http://localhost:5173,https://devrajrawat9027562124-web.github.io

# Runs per minute from one address
TRACE_RATE_LIMIT=20

# Seconds a C/C++ trace may take. Raise it (e.g. 60) for long menu sessions on a slow
# machine: GDB on Windows manages about 25 steps a second. Local mode only; Docker uses 15.
KAARAN_TIME_LIMIT=15

# LLM explainer ("Explain this step"). Leave the key empty to turn it off.
# Get a key at https://platform.claude.com ; usage is billed to your account.
ANTHROPIC_API_KEY=
KAARAN_MODEL=claude-opus-5-5
KAARAN_EFFORT=low
EXPLAIN_RATE_LIMIT=10

# Student accounts (optional; the tool works without logging in).
# The SQLite file holding accounts and saved programs. Ignored by git.
KAARAN_DB=kaaran.db
# Days a login lasts before the student logs in again
KAARAN_SESSION_DAYS=14
# Logins and signups per minute from one address (slows down password guessing)
AUTH_RATE_LIMIT=10
