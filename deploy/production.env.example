# Settings for the server. Copy to /opt/kaaran/backend/.env (see docs/deploy.md).
# Never commit the real file: it can hold your API key.

# Student code runs in a locked-down Docker container. Never "local" on a server.
KAARAN_SANDBOX=docker
KAARAN_RUNNER_IMAGE=kaaran-runner

# Only your website may call this backend
ALLOWED_ORIGINS=https://devrajrawat9027562124-web.github.io

# Accounts: kept on the server's disk, backed up daily to /var/backups/kaaran
KAARAN_DB=/var/lib/kaaran/kaaran.db
KAARAN_SESSION_DAYS=14
AUTH_RATE_LIMIT=10

# Email, for the sign-up codes: needed on a server (see docs/deploy.md, step 4).
# Google Cloud blocks port 25, but 587 (below) and 465 work.
# Gmail: turn on 2-Step Verification, then create an App Password
# (Google Account -> Security -> App passwords) and paste it below.
# Your normal Gmail password won't work, and never commit this file.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Runs per minute from one address, and runs at the same time (each may use 256 MB:
# use 2 on a 1 GB machine, 4 on 2 GB or more)
TRACE_RATE_LIMIT=20
KAARAN_PARALLEL_RUNS=2

# "Explain this step" (optional). Empty turns it off. Usage is billed to your account.
ANTHROPIC_API_KEY=
KAARAN_MODEL=claude-opus-5-5
KAARAN_EFFORT=low
EXPLAIN_RATE_LIMIT=10
